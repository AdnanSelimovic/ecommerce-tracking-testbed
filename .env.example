APP_NAME="Ecommerce Tracking Testbed"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_tracking_testbed
DB_USERNAME=root
DB_PASSWORD=
# Force InnoDB: some WampServer MySQL installs default to MyISAM, whose 1000-byte
# index limit breaks utf8mb4 unique string indexes.
DB_ENGINE=InnoDB

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Default currency used by the synthetic storefront and ground-truth events.
TESTBED_CURRENCY=EUR

# Public browser identifiers for the Milestone 3 client baseline. Leave blank
# to disable each provider independently. Never place API secrets/tokens here.
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
GA4_SERVER_MEASUREMENT_ID=
GA4_SERVER_API_SECRET=
GA4_SERVER_ENDPOINT=https://www.google-analytics.com/mp/collect
GA4_SERVER_DEBUG_ENDPOINT=https://www.google-analytics.com/debug/mp/collect
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0
META_CAPI_TEST_EVENT_CODE=
